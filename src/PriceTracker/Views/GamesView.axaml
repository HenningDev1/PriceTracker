<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceTracker.ViewModels"
             xmlns:c="using:PriceTracker.Controls"
             x:Class="PriceTracker.Views.GamesView"
             x:DataType="vm:GamesPageViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="28,26,28,0">

    <!-- Header -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel VerticalAlignment="Bottom">
        <TextBlock Text="Games" Classes="h1" />
        <TextBlock Text="{Binding Subtitle}" Classes="sub" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <TextBox Text="{Binding Filter}" Watermark="Filter" Width="170" />
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" Width="150" />
        <Button Command="{Binding ToggleSearchCommand}" ToolTip.Tip="Add a game from the Steam store">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="icon" Data="M12 5v14 M5 12h14" Width="12" Height="12" />
            <TextBlock Text="Add game" Foreground="{Binding $parent[Button].Foreground}" />
          </StackPanel>
        </Button>
        <Button Classes="accent" Command="{Binding ImportWishlistCommand}" ToolTip.Tip="Import / sync your Steam wishlist">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="icon" Data="M12 4v11 M7 10l5 5 5-5 M5 20h14" Width="12" Height="12" />
            <TextBlock Text="Sync wishlist" Foreground="{Binding $parent[Button].Foreground}" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh game prices" Padding="8">
          <Path Classes="icon" Data="M20 11a8 8 0 0 0-14.8-3.5M4 4v4h4 M4 13a8 8 0 0 0 14.8 3.5M20 20v-4h-4" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Steam store search (Add game) -->
    <Border Grid.Row="1" Classes="card" Padding="14" Margin="0,0,0,14" IsVisible="{Binding IsSearchOpen}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Name="SearchBox" Text="{Binding SearchText}" Watermark="Search the Steam store…">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" Content="Search" Command="{Binding SearchCommand}" />
        </Grid>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" Height="3" MinHeight="3" />
        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding SearchResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:SteamHitViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                  <Border CornerRadius="6" ClipToBounds="True" Width="92" Height="35" Background="{DynamicResource ChipBg}">
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding PriceText}" Classes="sub price" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button Grid.Column="3" Classes="link" Content="Track"
                          Command="{Binding $parent[ItemsControl].((vm:GamesPageViewModel)DataContext).AddCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="2" ColumnDefinitions="*,16,360">

      <!-- Empty state -->
      <Border Grid.ColumnSpan="3" Classes="card" IsVisible="{Binding IsEmpty}" VerticalAlignment="Top" Padding="40" Margin="0,10,0,0">
        <StackPanel HorizontalAlignment="Center" Spacing="10" MaxWidth="440">
          <Path Data="M7.5 6h9a5.5 5.5 0 0 1 5.4 6.6l-.9 4.4a2.6 2.6 0 0 1-4.6 1.1L14.6 16H9.4l-1.8 2.1A2.6 2.6 0 0 1 3 17l-.9-4.4A5.5 5.5 0 0 1 7.5 6Z"
                Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" />
          <TextBlock Text="No games tracked yet" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Classes="sub" TextWrapping="Wrap" TextAlignment="Center"
                     Text="Enter your Steam profile in Settings and press “Sync wishlist”. Price Tracker then follows Steam prices and the cheapest key on KeyForSteam for every game on your wishlist." />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="Open Settings" Command="{Binding GoToSettingsCommand}" />
            <Button Classes="accent" Content="Sync wishlist" Command="{Binding ImportWishlistCommand}" IsVisible="{Binding HasProfile}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- List -->
      <ListBox Classes="rows" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" Padding="0,0,0,20">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:GameViewModel">
            <Border Classes="card row" Padding="10">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Border CornerRadius="8" ClipToBounds="True" Width="120" Height="56" Background="{DynamicResource ChipBg}">
                  <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,2,10,0" VerticalAlignment="Center" Spacing="6" ClipToBounds="True">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontL}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="pill deal" IsVisible="{Binding IsDeal}" ToolTip.Tip="{Binding DealReasons}">
                      <TextBlock Text="{Binding DealBadge}" />
                    </Border>
                    <Border Classes="pill chip" IsVisible="{Binding !IsDeal}"><TextBlock Text="{Binding SourceText}" /></Border>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Width="112" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="STEAM" Classes="caps" HorizontalAlignment="Right" />
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Border Classes="pill discount" IsVisible="{Binding HasDiscount}" Padding="5,1">
                      <TextBlock Text="{Binding DiscountText}" />
                    </Border>
                    <TextBlock Text="{Binding SteamPriceText}" Classes="price" FontSize="{DynamicResource FontL}" />
                  </StackPanel>
                  <TextBlock Text="{Binding RegularText}" Classes="strike xs" HorizontalAlignment="Right" IsVisible="{Binding HasDiscount}" />
                </StackPanel>
                <Border Grid.Column="3" Width="1" Background="{DynamicResource Separator}" Margin="14,6,0,6" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="3" Width="112" Margin="15,0,4,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="BEST KEY" Classes="caps" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding KeyPriceText}" Classes="price" FontSize="{DynamicResource FontL}" HorizontalAlignment="Right"
                             Classes.good="{Binding KeyIsCheaper}" />
                  <TextBlock Text="{Binding KeyShopText}" Classes="sub xs" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Detail -->
      <ScrollViewer Grid.Column="2" IsVisible="{Binding !IsEmpty}" Padding="0,0,0,20">
        <Border Classes="card" Padding="0" DataContext="{Binding Selected}" x:DataType="vm:GameViewModel" ClipToBounds="True"
                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel>
            <Panel Height="182">
              <Image Source="{Binding Cover}" Stretch="UniformToFill" />
              <Border Classes="pill deal" IsVisible="{Binding IsDeal}" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{Binding DealBadge}" />
              </Border>
            </Panel>
            <StackPanel Margin="18,16,18,18" Spacing="14">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}" Classes="h2" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CheckedText}" Classes="sub small" Classes.error="{Binding HasError}" TextWrapping="Wrap" />
              </StackPanel>

              <Border Background="{DynamicResource DealSoftBrush}" CornerRadius="10" Padding="12,9" IsVisible="{Binding IsDeal}">
                <TextBlock Text="{Binding DealReasons}" TextWrapping="Wrap" Foreground="{DynamicResource DealBrush}" FontWeight="Medium" Classes="small" />
              </Border>

              <Grid ColumnDefinitions="*,12,*">
                <Border Classes="card" Padding="12" BoxShadow="none">
                  <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource SteamBrush}" />
                      <TextBlock Text="STEAM" Classes="caps" />
                    </StackPanel>
                    <TextBlock Text="{Binding SteamPriceText}" Classes="price h2" />
                    <TextBlock Classes="sub xs" IsVisible="{Binding HasDiscount}">
                      <Run Text="{Binding DiscountText}" /><Run Text=" · was " /><Run Text="{Binding RegularText}" />
                    </TextBlock>
                    <TextBlock Classes="sub xs"><Run Text="Lowest: " /><Run Text="{Binding AtlText}" /></TextBlock>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="12" BoxShadow="none">
                  <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource KeyBrush}" />
                      <TextBlock Text="BEST KEY" Classes="caps" />
                    </StackPanel>
                    <TextBlock Text="{Binding KeyPriceText}" Classes="price h2" />
                    <TextBlock Text="{Binding KeyShopText}" Classes="sub xs" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="sub xs"><Run Text="Lowest: " /><Run Text="{Binding KeyAtlText}" /></TextBlock>
                  </StackPanel>
                </Border>
              </Grid>

              <TextBlock Text="{Binding SavingsText}" Foreground="{DynamicResource GoodBrush}" FontWeight="SemiBold"
                         IsVisible="{Binding KeyIsCheaper}" />

              <StackPanel Spacing="6">
                <TextBlock Text="PRICE HISTORY" Classes="caps" />
                <c:PriceChart Height="210" Points="{Binding History}" SeriesAName="Steam" SeriesBName="Best key"
                              SeriesABrush="{DynamicResource SteamBrush}" SeriesBBrush="{DynamicResource KeyBrush}"
                              GridBrush="{DynamicResource ChartGrid}" LabelBrush="{DynamicResource TextSecondary}"
                              TooltipBackground="{DynamicResource TooltipBg}" FontFamily="{DynamicResource AppFont}" />
                <TextBlock Classes="sub xs" TextWrapping="Wrap">
                  <Run Text="All-time lows " /><Run Text="{Binding AtlSource}" /><Run Text=". Full Steam history on SteamDB." />
                </TextBlock>
              </StackPanel>

              <WrapPanel Orientation="Horizontal">
                <Button Classes="link" Command="{Binding OpenSteamCommand}" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Steam Store" Foreground="{Binding $parent[Button].Foreground}" FontSize="{DynamicResource FontS}" />
                    <Path Classes="icon" Data="M14 4h6v6 M20 4l-9 9 M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" Width="11" Height="11" />
                  </StackPanel>
                </Button>
                <Button Classes="link" Command="{Binding OpenKeysCommand}" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Key offers" Foreground="{Binding $parent[Button].Foreground}" FontSize="{DynamicResource FontS}" />
                    <Path Classes="icon" Data="M14 4h6v6 M20 4l-9 9 M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" Width="11" Height="11" />
                  </StackPanel>
                </Button>
                <Button Classes="link" Command="{Binding OpenGgDealsCommand}" IsVisible="{Binding HasGgDeals}" Margin="0,0,6,6"
                        ToolTip.Tip="Key prices and all-time lows provided by GG.deals">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Prices by GG.deals" Foreground="{Binding $parent[Button].Foreground}" FontSize="{DynamicResource FontS}" />
                    <Path Classes="icon" Data="M14 4h6v6 M20 4l-9 9 M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" Width="11" Height="11" />
                  </StackPanel>
                </Button>
                <Button Classes="link" Command="{Binding OpenSteamDbCommand}" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="SteamDB" Foreground="{Binding $parent[Button].Foreground}" FontSize="{DynamicResource FontS}" />
                    <Path Classes="icon" Data="M14 4h6v6 M20 4l-9 9 M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" Width="11" Height="11" />
                  </StackPanel>
                </Button>
              </WrapPanel>
              <Button Classes="ghost danger" Command="{Binding RemoveCommand}" HorizontalAlignment="Left" Content="Stop tracking" />
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
