<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PriceTracker.ViewModels"
        xmlns:v="using:PriceTracker.Views"
        x:Class="PriceTracker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Price Tracker"
        Icon="/Assets/app.ico"
        Width="1180" Height="760" MinWidth="900" MinHeight="580"
        Background="{DynamicResource WindowBg}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:GamesPageViewModel"><v:GamesView /></DataTemplate>
    <DataTemplate DataType="vm:ItemsPageViewModel"><v:ItemsView /></DataTemplate>
    <DataTemplate DataType="vm:DealsPageViewModel"><v:DealsView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsPageViewModel"><v:SettingsView /></DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Ellipse.light">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="StrokeThickness" Value="0.5" />
      <Setter Property="Stroke" Value="#26000000" />
    </Style>
    <Style Selector="Path.glyph">
      <Setter Property="Stroke" Value="#99000000" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="StackPanel#Lights:pointerover Path.glyph">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Window:not(:focus-within) Ellipse.light">
      <Setter Property="Fill" Value="#C8C8CC" />
    </Style>
    <Style Selector="Panel.lightbtn">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Border Name="Root" ClipToBounds="True" Background="{DynamicResource WindowBg}">
    <Grid ColumnDefinitions="232,*">

      <!-- ───────── Sidebar ───────── -->
      <Border Grid.Column="0" Background="{DynamicResource SidebarBg}"
              BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- Title bar area with traffic lights (drag to move) -->
          <Panel Name="SidebarDrag" DockPanel.Dock="Top" Height="52" Background="Transparent">
            <StackPanel Name="Lights" Orientation="Horizontal" Spacing="8" Margin="18,0,0,0"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
              <Panel Name="CloseLight" Classes="lightbtn" ToolTip.Tip="Close">
                <Ellipse Classes="light" Fill="#FF5F57" />
                <Path Classes="glyph" Data="M0,0 L6,6 M6,0 L0,6" />
              </Panel>
              <Panel Name="MinLight" Classes="lightbtn" ToolTip.Tip="Minimize">
                <Ellipse Classes="light" Fill="#FEBC2E" />
                <Path Classes="glyph" Data="M0,3 L6,3" Height="1.5" />
              </Panel>
              <Panel Name="MaxLight" Classes="lightbtn" ToolTip.Tip="Zoom">
                <Ellipse Classes="light" Fill="#28C840" />
                <Path Classes="glyph" Data="M0,3 L6,3 M3,0 L3,6" />
              </Panel>
            </StackPanel>
          </Panel>

          <!-- App identity -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="18,2,18,18">
            <Image Source="/Assets/app-256.png" Width="34" Height="34" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Price Tracker" FontWeight="Bold" FontSize="{DynamicResource FontL}" />
              <TextBlock Text="Games · Keys · Hardware" Classes="sub xs" />
            </StackPanel>
          </StackPanel>

          <!-- Footer: status + refresh -->
          <Border DockPanel.Dock="Bottom" Margin="12,0,12,14" Padding="12" Classes="card">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding LastRefreshText}" Classes="small" FontWeight="Medium" />
                  <TextBlock Text="{Binding Status}" Classes="sub xs" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Status}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Command="{Binding RefreshAllCommand}"
                        IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Refresh everything now" Padding="7">
                  <Path Classes="icon" Data="M20 11a8 8 0 0 0-14.8-3.5M4 4v4h4 M4 13a8 8 0 0 0 14.8 3.5M20 20v-4h-4" />
                </Button>
              </Grid>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" MinHeight="3" CornerRadius="2" />
            </StackPanel>
          </Border>

          <ListBox Classes="nav" Margin="10,0" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:NavItem">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Path Classes="navicon" Data="{Binding Icon}" Width="17" Height="17" Stretch="Uniform"
                        Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.7"
                        StrokeLineCap="Round" StrokeJoin="Round" />
                  <TextBlock Grid.Column="1" Classes="navlabel" Text="{Binding Label}" Margin="11,0,0,0"
                             VerticalAlignment="Center" FontWeight="Medium" />
                  <Border Grid.Column="2" Classes="pill deal" IsVisible="{Binding HasBadge}" Padding="7,1">
                    <TextBlock Text="{Binding Badge}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ───────── Content ───────── -->
      <Panel Grid.Column="1">
        <TransitioningContentControl Content="{Binding Current}">
          <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:0:0.12" />
          </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
      </Panel>
    </Grid>
  </Border>
</Window>
